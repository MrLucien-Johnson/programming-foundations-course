# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Required in production — use a long random string
JWT_SECRET=dev-only-change-me-before-production

# Comma-separated browser origins allowed to call the API
# Example for GitHub Pages: https://mrlucien-johnson.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,null

# SQLite database file path
DATABASE_PATH=./data/pf.sqlite

# Comma-separated, case-insensitive allowlist of emails allowed to create an
# organisation or hold the "admin" membership role. Only the site owner should
# be listed here for now. Fails closed: if unset/empty, NO ONE can create an
# org or be promoted to admin (learners/guests are unaffected).
# Example: ORG_CREATOR_EMAILS=owner@example.com
ORG_CREATOR_EMAILS=

# Extra emails that can always open donor/premium courses (DevOps, AWS, Azure,
# GCP, Kubernetes, Terraform) and grant/revoke donor flags for other accounts.
# ORG_CREATOR_EMAILS are included automatically. Example:
# PREMIUM_CONTENT_GIT_URL=https://github.com/YOU/programming-foundations-premium.git
# PREMIUM_CONTENT_GIT_TOKEN=ghp_readonly_or_fine_grained
# PREMIUM_CONTENT_ROOT=/absolute/path/to/checkout   # optional local override
# PREMIUM_CONTENT_DIR=./data/premium-content        # git clone target
# PREMIUM_ACCESS_EMAILS=friend@example.com,mentor@example.com
PREMIUM_ACCESS_EMAILS=
PREMIUM_CONTENT_GIT_URL=
PREMIUM_CONTENT_GIT_TOKEN=
