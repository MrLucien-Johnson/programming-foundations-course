# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Required in production — use a long random string (openssl rand -hex 32)
JWT_SECRET=dev-only-change-me-before-production

# Public API URL used in OAuth redirect_uri (no trailing slash).
# On Render this can be left unset; RENDER_EXTERNAL_URL is used automatically.
# PUBLIC_API_BASE=https://your-api.onrender.com

# Default page to return to after social sign-in if return_to is omitted
FRONTEND_DEFAULT_RETURN=http://127.0.0.1:5500/docs/account.html

# Comma-separated browser origins allowed to call the API
# Example for GitHub Pages: https://mrlucien-johnson.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,null

# SQLite database file path
DATABASE_PATH=./data/pf.sqlite

# --- Optional social sign-in (leave blank to hide those buttons) ---
# Google Cloud Console → OAuth client (Web): redirect
#   {PUBLIC_API_BASE}/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth App: callback
#   {PUBLIC_API_BASE}/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Microsoft Entra app registration: redirect
#   {PUBLIC_API_BASE}/api/auth/oauth/microsoft/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Apple Sign In (Services ID). Private key PEM; use \n for newlines in env.
# Callback: {PUBLIC_API_BASE}/api/auth/oauth/apple/callback
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Comma-separated, case-insensitive allowlist of emails allowed to create an
# organisation or hold the "admin" membership role. Only the site owner should
# be listed here for now. Fails closed: if unset/empty, NO ONE can create an
# org or be promoted to admin (learners/guests are unaffected).
# Example: ORG_CREATOR_EMAILS=owner@example.com
ORG_CREATOR_EMAILS=
